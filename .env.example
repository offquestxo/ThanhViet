# Copy to .env.local and fill in real values from Supabase → Project Settings → API.
# .env.local is gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses Row-Level Security. Never expose to the client.
SUPABASE_SECRET_KEY=

# Tone engine (Modal). Server-side only — never NEXT_PUBLIC_. The shared
# secret must equal TONE_ENGINE_SHARED_SECRET in the Modal secret
# `thanhviet-tone-shared`.
MODAL_TONE_ENGINE_URL=
TONE_ENGINE_SHARED_SECRET=
